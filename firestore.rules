rules_version = '2';

// Cada pessoa só pode ler e escrever dentro da própria "pasta"
// (/users/{seu-uid}/...). O uid vem do login (Firebase Authentication),
// então ninguém consegue ler ou escrever nos dados de outra pessoa, mesmo
// sabendo o link do app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
