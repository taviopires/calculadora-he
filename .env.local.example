# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto Firebase (Project settings > General > "Your apps" > Web app).
# Veja o README para o passo a passo completo de criação do projeto.
#
# Essas chaves NÃO são segredo — o SDK do Firebase para navegador foi
# desenhado para que essa configuração seja pública. Quem protege os dados
# de cada pessoa são as Regras de Segurança do Firestore (firestore.rules),
# e não o sigilo dessas variáveis.
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="seu-projeto"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="seu-projeto.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
